// Tasks for Robot Framework files. They use `robotcode robot`, which reads
// robot.toml (python-path, variables, env, ...); install it in the project's
// environment with `pip install robotcode`. Each of these can also be started
// under the debugger from the run button menu.
[
  {
    "label": "robot: test $ZED_CUSTOM_robot_test_name",
    "command": "robotcode",
    "args": ["robot", "--test", "\"$ZED_CUSTOM_robot_test_name\"", "\"$ZED_FILE\""],
    "cwd": "$ZED_WORKTREE_ROOT",
    "tags": ["robot-test"]
  },
  {
    "label": "robot: suite $ZED_FILENAME",
    "command": "robotcode",
    "args": ["robot", "\"$ZED_FILE\""],
    "cwd": "$ZED_WORKTREE_ROOT",
    "tags": ["robot-suite"]
  },
  {
    "label": "robot: folder $ZED_DIRNAME",
    "command": "robotcode",
    "args": ["robot", "\"$ZED_DIRNAME\""],
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "robot: all tests",
    "command": "robotcode",
    "args": ["robot", "."],
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "robot: dry run $ZED_FILENAME",
    "command": "robotcode",
    "args": ["robot", "--dryrun", "\"$ZED_FILE\""],
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  // Troubleshooting: why is a keyword "not found"?
  {
    "label": "robot: check imports of $ZED_FILENAME",
    "command": "robotcode",
    "args": ["analyze", "code", "\"$ZED_FILE\""],
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    // Select a library path as written in the file, e.g. ../libs/MyLib.py
    "label": "robot: keywords in library file $ZED_SELECTED_TEXT",
    "command": "robotcode",
    "args": ["libdoc", "\"$ZED_DIRNAME/$ZED_SELECTED_TEXT\"", "list"],
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    // Select a library name, e.g. SSHLibrary or my_package.MyLib
    "label": "robot: keywords in library $ZED_SELECTED_TEXT",
    "command": "robotcode",
    "args": ["libdoc", "\"$ZED_SELECTED_TEXT\"", "list"],
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  // Results of the last run (robot writes log.html / report.html to the
  // directory it runs in, the project root for the tasks above, unless
  // robot.toml sets output-dir).
  {
    "label": "robot: open log.html",
    "command": "python3",
    "args": ["-m", "webbrowser", "-t", "\"file://$ZED_WORKTREE_ROOT/log.html\""],
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "robot: open report.html",
    "command": "python3",
    "args": ["-m", "webbrowser", "-t", "\"file://$ZED_WORKTREE_ROOT/report.html\""],
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    // For dev containers and remote projects, where no browser can be opened:
    // serves the results on http://localhost:8000/log.html. Forward port 8000
    // to your machine to open it there. Stop the task to stop the server.
    "label": "robot: serve results on port 8000",
    "command": "python3",
    "args": ["-m", "http.server", "8000", "--bind", "127.0.0.1"],
    "cwd": "$ZED_WORKTREE_ROOT"
  }
]
