// Tasks for Robot Framework files. They use `robotcode robot`, which reads
// robot.toml (python-path, variables, env, ...); install it in the project's
// environment with `pip install robotcode`. Each of these can also be started
// under the debugger from the run button menu.
[
  {
    "label": "robot: test $ZED_CUSTOM_robot_test_name",
    "command": "robotcode",
    "args": ["robot", "--test", "\"$ZED_CUSTOM_robot_test_name\"", "\"$ZED_FILE\""],
    "cwd": "$ZED_WORKTREE_ROOT",
    "tags": ["robot-test"]
  },
  {
    "label": "robot: suite $ZED_FILENAME",
    "command": "robotcode",
    "args": ["robot", "\"$ZED_FILE\""],
    "cwd": "$ZED_WORKTREE_ROOT",
    "tags": ["robot-suite"]
  },
  {
    "label": "robot: folder $ZED_DIRNAME",
    "command": "robotcode",
    "args": ["robot", "\"$ZED_DIRNAME\""],
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "robot: all tests",
    "command": "robotcode",
    "args": ["robot", "."],
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "robot: dry run $ZED_FILENAME",
    "command": "robotcode",
    "args": ["robot", "--dryrun", "\"$ZED_FILE\""],
    "cwd": "$ZED_WORKTREE_ROOT"
  }
]
