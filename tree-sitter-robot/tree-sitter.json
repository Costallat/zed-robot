{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "robot",
      "camelcase": "Robot",
      "title": "Robot",
      "scope": "source.robot",
      "file-types": [
        "robot",
        "resource"
      ],
      "injection-regex": "^robot$",
      "class-name": "TreeSitterRobot"
    }
  ],
  "metadata": {
    "version": "1.5.0",
    "license": "ISC",
    "description": "Tree-sitter parser for Robot Framework files (vendored in zed-robot, based on Hubro/tree-sitter-robot)",
    "authors": [
      {
        "name": "Tomas Sandven",
        "url": "https://github.com/Hubro/tree-sitter-robot"
      }
    ],
    "links": {
      "repository": "https://github.com/Hubro/tree-sitter-robot"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
